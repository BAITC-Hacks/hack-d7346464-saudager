# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.
# Без необязательных переменных приложение запускается, основной сценарий работает.

# --- Обязательные ---
# PORT=3000
# DATABASE_URL=file:./data/app.sqlite

# --- Необязательные: AI-функции (без ключа соответствующая функция сообщает, что недоступна) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=
